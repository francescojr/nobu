{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/update_changelog_session.py sessionStart",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "python .cursor/hooks/update_changelog_session.py sessionEnd",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/update_changelog_session.py stop",
        "timeout": 60,
        "loop_limit": 0
      }
    ]
  }
}
