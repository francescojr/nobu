// Kilo Code v7+ — portable defaults (bootstrap rewrites with venv paths).
// https://kilo.ai/docs/automate/mcp/using-in-kilo-code
{
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/skills/game-music-producer/SKILL.md",
    ".kilo/rules/nobu.md"
  ],
  "mcp": {
    "nobu": {
      "type": "local",
      "command": ["python", "nobu_mcp.py"],
      "enabled": true,
      "timeout": 30000
    }
  }
}
